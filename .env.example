# Explicit opt-in: demo is the default. No credentials needed for demo.
LEDGER_DATA_DIR=./data
ALPHAVANTAGE_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
# Clone upstream Kronos here and install its requirements only to enable real inference.
KRONOS_PATH=
KRONOS_DEVICE=cpu
# Required when exposing API outside localhost. Use a long random value.
LEDGER_API_TOKEN=

# Optional intraday data. Alpaca takes priority over Alpha Vantage for the price panel.
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# LEDGER_ALPACA_FEED=iex
# Enable only with Alpha Vantage real-time US quote entitlement:
# LEDGER_AV_REALTIME=1
